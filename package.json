{
  "name": "documentation-pdf-scraper",
  "version": "2.0.0",
  "description": "Professional documentation scraper & Markdown-to-PDF converter with device optimization",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "start:clean": "npm run clean && npm start",
    "clean": "rm -rf pdfs/*/ pdfs/finalPdf/* pdfs/metadata/*",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"{src,tests,scripts}/**/*.js\"",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.js\" --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{js,mjs,cjs,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{js,mjs,cjs,md,json,yml,yaml}\"",
    "docs:openai": "node scripts/use-doc-target.js use openai",
    "docs:claude": "node scripts/use-doc-target.js use claude-code",
    "docs:claude-curated": "node scripts/use-doc-target.js use claude-code-curated",
    "docs:openclaw": "node scripts/use-doc-target.js use openclaw-zh-cn",
    "docs:list": "node scripts/use-doc-target.js list",
    "docs:current": "node scripts/use-doc-target.js current",
    "docs:anthropic": "node scripts/use-doc-target.js use anthropic-research",
    "docs:claude-blog": "node scripts/use-doc-target.js use claude-blog",
    "docs:openclaw:update-urls": "node scripts/update-openclaw-target-urls.js",
    "docs:openclaw:verify": "node scripts/verify-openclaw-target-coverage.js",
    "docs:openclaw:verify:warn": "OPENCLAW_VERIFY_ALLOW_FETCH_FAILURE=1 OPENCLAW_VERIFY_WARN_ONLY=1 node scripts/verify-openclaw-target-coverage.js"
  },
  "keywords": [
    "scraper",
    "pdf",
    "nextjs",
    "puppeteer"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^6.0.0",
    "joi": "^18.2.8",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.3.3",
    "puppeteer": "^25.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "turndown": "^7.2.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
